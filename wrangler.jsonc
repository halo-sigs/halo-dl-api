{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halo-dl-api",
  "main": "./dist/index.js",
  "compatibility_date": "2026-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "pnpm run build"
  },
  "r2_buckets": [
    {
      "binding": "dl_halo_run",
      "bucket_name": "dl-halo-run"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
